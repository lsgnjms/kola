# Copy to .env and fill in. Never commit .env.

# --- API server ---
API_PORT=3000
# Loopback only: browsers (incl. phones via `pnpm dev:lan`) reach the API through the web dev proxy.
API_HOST=127.0.0.1
LOG_LEVEL=info
# Comma-separated origins allowed to call the API (the PWA dev server by default)
CORS_ORIGINS=http://localhost:5173
# The API's URL(s) as browsers see it, comma-separated (NIP-98 request signatures cover it).
# For phone testing with `pnpm dev:lan`, add your PC's LAN address, e.g.
# PUBLIC_API_URLS=http://localhost:5173/api,http://192.168.1.20:5173/api
PUBLIC_API_URLS=http://localhost:5173/api
BITCOIN_NETWORK=regtest
# Local SQLite cache (relative to repo root)
DB_PATH=data/kola.sqlite

# --- Member wallets (demo: custodial regtest nodes, one per member) ---
# name=REST URL; cert + wallet.macaroon are read from infra/data/<name>/
MEMBER_NODES=alice=https://localhost:8082,bob=https://localhost:8083,carol=https://localhost:8084

# --- Lightning (regtest) ---
# Paths are relative to the repo root; the regtest stack writes them under infra/data/.
COORDINATOR_LND_REST_URL=https://localhost:8081
COORDINATOR_LND_TLS_CERT_PATH=infra/data/coordinator/tls.cert
# Least privilege: `pnpm seed` bakes two URI-scoped macaroons.
#  invoice.macaroon: create/settle/cancel/lookup/subscribe invoices only (cannot send money)
#  payout.macaroon:  decode/send/track payments + channel balance (cannot open/close channels or spend on-chain)
COORDINATOR_INVOICE_MACAROON_PATH=infra/data/coordinator/kola/invoice.macaroon
COORDINATOR_PAYOUT_MACAROON_PATH=infra/data/coordinator/kola/payout.macaroon

# --- Spend caps (sats) ---
MAX_PAYMENT_SAT=100000
MAX_DAILY_SPEND_SAT=500000
MAX_PAYOUT_FEE_SAT=50

# --- Savings circles ---
# How long members have to pay their share once a round opens (demo: minutes, production <= 24h)
CONTRIBUTION_WINDOW_SECONDS=300
# 32-byte hex secret that hold-invoice preimages are derived from. Leave empty to have one
# generated next to the database (data/coordinator-preimage.secret) on first start.
COORDINATOR_PREIMAGE_SECRET=

# --- Nostr ---
NOSTR_RELAY_URL=ws://127.0.0.1:7777
# Coordinator signing key (32-byte hex). Leave empty to have one generated next to the
# database (data/coordinator-nostr.secret) on first start. Never reuse a real key.
COORDINATOR_NSEC=

# --- AI (optional) ---
# Leave empty to run with templated assistant answers.
ANTHROPIC_API_KEY=
