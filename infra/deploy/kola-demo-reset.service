# Puts the shared demo back to "round 1 ready" and frees the spare wallets.
[Unit]
Description=Kola: reset the shared demo circle

[Service]
Type=oneshot
User=kola
WorkingDirectory=/opt/kola
# "+" runs these two steps as root (needed to stop and start another service).
ExecStartPre=+/bin/systemctl stop kola-api.service
ExecStart=/opt/kola/node_modules/.bin/tsx --env-file=.env scripts/demo.ts reset
# Always bring the API back, even if the reset failed.
ExecStopPost=+/bin/systemctl start kola-api.service
