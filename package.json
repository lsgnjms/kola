{
  "name": "kola",
  "private": true,
  "description": "Lightning-powered rotating savings circles (tontine / ajo / esusu)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:lan": "pnpm --parallel --filter \"./apps/*\" dev:lan",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "smoke": "tsx scripts/smoke-lnd.ts",
    "test:integration": "pnpm --filter @kola/api test:integration",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "demo:reset": "tsx --env-file-if-exists=.env scripts/demo.ts reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "nostr-tools": "^2.10.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
